rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasActiveMembership(orgId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/memberships/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)/memberships/$(request.auth.uid)).data.status == 'ACTIVE';
    }

    function isOrgAdmin(orgId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/memberships/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)/memberships/$(request.auth.uid)).data.status == 'ACTIVE' &&
        get(/databases/$(database)/documents/organizations/$(orgId)/memberships/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // Users collection (/users/{userId})
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || resource == null);
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Organizations collection & multi-tenant subcollections
    match /organizations/{orgId} {
      // Criação de novas igrejas permitida para usuários autenticados
      allow create: if isAuthenticated();
      // Leitura permitida se membro ativo ou se for consulta inicial
      allow read: if isAuthenticated() && (hasActiveMembership(orgId) || resource.data.subscription.status == 'ACTIVE');
      allow update, delete: if isOrgAdmin(orgId);

      // Subcoleção: Campi / Congregações
      match /campuses/{campusId} {
        allow read: if hasActiveMembership(orgId);
        allow write: if isOrgAdmin(orgId);
      }

      // Subcoleção: Membros & Permissões
      match /memberships/{memUserId} {
        allow read: if isAuthenticated() && (hasActiveMembership(orgId) || request.auth.uid == memUserId);
        allow create: if isAuthenticated() && (isOrgAdmin(orgId) || request.auth.uid == memUserId);
        allow update, delete: if isOrgAdmin(orgId) || (request.auth.uid == memUserId && request.resource.data.role == resource.data.role);
      }

      // Subcoleção: Tarefas / Demandas (Kanban)
      match /tasks/{taskId} {
        allow read, write: if hasActiveMembership(orgId);
      }

      // Subcoleção: Projetos & Eventos
      match /events/{eventId} {
        allow read, write: if hasActiveMembership(orgId);
      }

      // Subcoleção: Comentários
      match /comments/{commentId} {
        allow read, create: if hasActiveMembership(orgId);
        allow update, delete: if hasActiveMembership(orgId) && (request.auth.uid == resource.data.userId || isOrgAdmin(orgId));
      }

      // Subcoleção: Notificações
      match /notifications/{notifId} {
        allow read, write: if hasActiveMembership(orgId);
      }

      // Subcoleção: Regras de Automação
      match /automationRules/{ruleId} {
        allow read: if hasActiveMembership(orgId);
        allow write: if isOrgAdmin(orgId);
      }

      // Subcoleção: Logs de Auditoria
      match /activities/{activityId} {
        allow read, create: if hasActiveMembership(orgId);
      }

      // Subcoleção: Configurações da Organização
      match /settings/{settingId} {
        allow read: if hasActiveMembership(orgId);
        allow write: if isOrgAdmin(orgId);
      }
    }
  }
}
