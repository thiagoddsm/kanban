rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Usuários: leitura e escrita para usuários autenticados
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Organizações e todas as suas subcoleções (memberships, tasks, campuses, events, etc.)
    // Acesso protegido: exige 100% de autenticação no Firebase Auth
    match /organizations/{orgId} {
      allow read, write: if isAuthenticated();

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
